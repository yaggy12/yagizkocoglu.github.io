def main():
    clock = pygame.time.Clock()
    try:
        scenes = create_scenes_file()
    except Exception as e:
        print(f"Error: Failed to create scenes file: {e}")
        pygame.quit()
        sys.exit(1)

    game_state = GameState()
    combat_system = None
    buttons = [
        Button(WIDTH // 2 - 100, HEIGHT // 2 - 50, 200, 60, "Play", BLUE, GREEN),
        Button(WIDTH // 2 - 100, HEIGHT // 2 + 20, 200, 60, "Continue", BLUE, GREEN),
        Button(WIDTH // 2 - 100, HEIGHT // 2 + 90, 200, 60, "Quit", BLUE, RED)
    ]
    outcome_buttons = [
        Button(WIDTH // 2 - 100, HEIGHT // 2 + 160, 200, 60, "Menu", BLUE, GREEN),
        Button(WIDTH // 2 - 100, HEIGHT // 2 + 230, 200, 60, "Quit", BLUE, RED)
    ]

    while True:
        mouse_pos = pygame.mouse.get_pos()
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

            if game_state.game_mode == "menu":
                for button in buttons:
                    if button.is_clicked(mouse_pos, event):
                        if button.text == "Play":
                            game_state = GameState()
                            game_state.initialize_card(scenes, disable_down_swipe=False)
                            game_state.game_mode = "story"
                        elif button.text == "Continue":
                            game_state = GameState()
                            if game_state.load_progress(scenes):
                                game_state.game_mode = "story"
                                if game_state.current_scene.startswith("boss_"):
                                    combat_system = CombatSystem(game_state.boss_path, game_state.player)
                                    game_state.game_mode = "combat"
                        elif button.text == "Quit":
                            pygame.quit()
                            sys.exit()

            elif game_state.game_mode == "story":
                if game_state.card:
                    game_state.card.handle_event(event, mouse_pos)
                    if game_state.card.decision_made:
                        choice = "A" if game_state.card.decision == "left" else "B" if game_state.card.decision == "right" else "C"
                        options = scenes[game_state.current_scene]["options"]
                        next_scene = options[0]["next"] if choice == "A" else options[1]["next"] if choice == "B" else options[2]["next"] if choice == "C" and not game_state.first_decision_made else options[0]["next"]
                        game_state.add_choice(choice, scenes)
                        game_state.next_scene = next_scene
                        game_state.card = None

            elif game_state.game_mode == "combat" and combat_system:
                if combat_system.current_turn == "player" and combat_system.player.can_act:
                    if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                        card_width, card_height = 150, 200
                        cards_start_x = (WIDTH - (len(combat_system.player.hand) * (card_width + 20) - 20)) // 2
                        for i in range(len(combat_system.player.hand)):
                            card_x = cards_start_x + i * (card_width + 20)
                            card_y = HEIGHT - card_height - 50
                            card_rect = pygame.Rect(card_x, card_y, card_width, card_height)
                            if card_rect.collidepoint(mouse_pos):
                                combat_system.player_attack(i)
                                break

            elif game_state.game_mode in ["victory", "defeat"]:
                for button in outcome_buttons:
                    if button.is_clicked(mouse_pos, event):
                        if button.text == "Menu":
                            game_state = GameState()
                            game_state.game_mode = "menu"
                            combat_system = None
                        elif button.text == "Quit":
                            pygame.quit()
                            sys.exit()

        # Update
        for button in buttons:
            button.update(mouse_pos)
        for button in outcome_buttons:
            button.update(mouse_pos)

        if game_state.game_mode == "story":
            if game_state.update():
                if game_state.current_scene.startswith("boss_"):
                    combat_system = CombatSystem(game_state.boss_path, game_state.player)
                    game_state.game_mode = "combat"
                else:
                    game_state.initialize_card(scenes, disable_down_swipe=game_state.first_decision_made)
        elif game_state.game_mode == "combat" and combat_system:
            combat_system.update()
            if combat_system.player.health <= 0:
                game_state.game_mode = "defeat"
                combat_system = None
            elif combat_system.enemy.health <= 0:
                game_state.game_mode = "victory"
                combat_system = None

        # Draw
        screen.fill(BLACK)

        if game_state.game_mode == "menu":
            title_text = font_title.render("The King: Card Adventure", True, GOLD)
            title_rect = title_text.get_rect(center=(WIDTH // 2, HEIGHT // 4))
            screen.blit(title_text, title_rect)
            for button in buttons:
                button.draw(screen)

        elif game_state.game_mode == "story":
            if game_state.card:
                game_state.card.update(mouse_pos)
                game_state.card.draw(screen)

        elif game_state.game_mode == "combat" and combat_system:
            draw_boss(screen, combat_system.boss_type)
            draw_health_bars(screen, combat_system.player.health, combat_system.enemy.health, combat_system.enemy.max_health, combat_system)
            draw_combat_cards(screen, combat_system.player.hand, combat_system)
            # Draw stamina
            stamina_text = font_body.render(f"Stamina: {combat_system.player.stamina}/{combat_system.player.max_stamina}", True, WHITE)
            stamina_rect = stamina_text.get_rect(topleft=(50, HEIGHT - 50))
            screen.blit(stamina_text, stamina_rect)
            # Draw block amount
            block_text = font_body.render(f"Block: {combat_system.player.block_amount}", True, WHITE)
            block_rect = block_text.get_rect(topleft=(50, HEIGHT - 80))
            screen.blit(block_text, block_rect)
            if combat_system.message_timer > 0:
                message_text = font_body.render(combat_system.message, True, WHITE)
                message_rect = message_text.get_rect(center=(WIDTH // 2, HEIGHT - 300))
                screen.blit(message_text, message_rect)

        elif game_state.game_mode == "victory":
            victory_text = font_title.render("Victory!", True, GOLD)
            victory_rect = victory_text.get_rect(center=(WIDTH // 2, HEIGHT // 4))
            screen.blit(victory_text, victory_rect)
            message_text = font_body.render(f"You have slain the {game_state.boss_path.capitalize()} and broken the mine's curse!", True, WHITE)
            message_rect = message_text.get_rect(center=(WIDTH // 2, HEIGHT // 3))
            screen.blit(message_text, message_rect)
            for button in outcome_buttons:
                button.draw(screen)

        elif game_state.game_mode == "defeat":
            defeat_text = font_title.render("Defeat", True, RED)
            defeat_rect = defeat_text.get_rect(center=(WIDTH // 2, HEIGHT // 4))
            screen.blit(defeat_text, defeat_rect)
            message_text = font_body.render(f"The {game_state.boss_path.capitalize()} has bested you. The mine's curse claims another soul.", True, WHITE)
            message_rect = message_text.get_rect(center=(WIDTH // 2, HEIGHT // 3))
            screen.blit(message_text, message_rect)
            for button in outcome_buttons:
                button.draw(screen)

        try:
            pygame.display.flip()
        except Exception as e:
            print(f"Error: Failed to update display: {e}")
            pygame.quit()
            sys.exit(1)

        clock.tick(60)

if __name__ == "__main__":
    main()
